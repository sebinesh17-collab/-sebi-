rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        getUserRole() == 'MODERATOR' || 
        getUserRole() == 'ADMIN' || 
        getUserRole() == 'SUPER_ADMIN'
      );
    }
    
    function isMatchOfficial() {
      return isAuthenticated() && (
        getUserRole() == 'REFEREE' || 
        getUserRole() == 'ORGANIZER' || 
        isStaff()
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && request.resource.data.role == 'USER';
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isStaff();
      allow delete: if isStaff();
    }

    // Tournaments Collection
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        getUserRole() == 'ORGANIZER' || 
        isStaff()
      );
      allow update: if isAuthenticated() && (
        (resource.data.organizerId == request.auth.uid) || 
        isStaff()
      );
      allow delete: if isStaff();
    }

    // Matches & Live Scoring
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isMatchOfficial();
      allow delete: if isStaff();
    }

    // Match Events (Immutable stream)
    match /matchEvents/{eventId} {
      allow read: if true;
      allow create: if isMatchOfficial();
      allow update, delete: if isStaff();
    }

    // Teams & Players
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.managerId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }
    
    match /players/{playerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    // Registrations
    match /registrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.captainId == request.auth.uid || 
        get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data.organizerId == request.auth.uid ||
        isStaff()
      );
      allow delete: if isStaff();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isStaff();
    }

    // Rule Profiles
    match /ruleProfiles/{profileId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow create: if isAuthenticated();
      allow update, delete: if false; // strictly immutable
    }
  }
}
